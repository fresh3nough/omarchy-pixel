#!/bin/bash
# Start Waybar with a fresh private D-Bus session. This prevents stale proot
# machine-id/autolaunch state (for example after omarchy-rice) from killing it.
unset DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
export HOME="${HOME:-/home/cody}"
export PATH="$HOME/.local/bin:/usr/bin:$PATH"
if command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- waybar "$@"
fi
exec waybar "$@"
