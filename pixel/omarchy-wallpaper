#!/bin/bash
export PATH="${HOME:-/home/cody}/.local/bin:/usr/bin:$PATH" DISPLAY="${DISPLAY:-:0}"
export GLYCIN_DISABLE_SANDBOX=1 BUBBLEWRAP_SKIP=1
BG="${HOME:-/home/cody}/.local/share/omarchy-pixel/backgrounds/1-quattro.jpg"
[ -f "$BG" ] || BG=/sdcard/omarchy-pixel/backgrounds/1-quattro.jpg
[ -f "$BG" ] || exit 0
SP=$(pgrep -x sway | head -1)
if [ -n "$SP" ] && [ -r /proc/$SP/environ ]; then
  tr '\0' '\n' < /proc/$SP/environ > /tmp/sway.env.wp 2>/dev/null || true
  WD=$(grep '^WAYLAND_DISPLAY=' /tmp/sway.env.wp 2>/dev/null | head -1 | cut -d= -f2-)
  XR=$(grep '^XDG_RUNTIME_DIR=' /tmp/sway.env.wp 2>/dev/null | head -1 | cut -d= -f2-)
  [ -n "$WD" ] && export WAYLAND_DISPLAY=$WD
  [ -n "$XR" ] && export XDG_RUNTIME_DIR=$XR
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.run}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || { [ -S $HOME/.run/wayland-1 ] && export XDG_RUNTIME_DIR=$HOME/.run WAYLAND_DISPLAY=wayland-1; }
if [ -x /usr/bin/bwrap ] && ! head -1 /usr/bin/bwrap 2>/dev/null | grep -q bash; then
  [ -f /usr/bin/bwrap.real ] || sudo mv /usr/bin/bwrap /usr/bin/bwrap.real 2>/dev/null
  printf '%s\n' '#!/usr/bin/bash' 'cmd=(); args=("$@")' 'for i in "${!args[@]}"; do a="${args[$i]}"; [[ "$a" == *glycin-loaders* ]] && { cmd=("${args[@]:$i}"); break; }; [ "$a" = "--" ] && { cmd=("${args[@]:$((i+1))}"); break; }; done' '[ ${#cmd[@]} -eq 0 ] && exit 1' 'export PATH=/usr/bin:/bin HOME=/tmp XDG_RUNTIME_DIR=/tmp LD_LIBRARY_PATH=/usr/lib' 'exec "${cmd[@]}"' | sudo tee /usr/bin/bwrap >/dev/null
  sudo chmod 755 /usr/bin/bwrap 2>/dev/null
fi
pkill -x swaybg 2>/dev/null; pkill -x feh 2>/dev/null
: > /tmp/swaybg.log
GLYCIN_DISABLE_SANDBOX=1 swaybg -o '*' -i "$BG" -m fill >>/tmp/swaybg.log 2>&1 &
sleep 1.2
pgrep -x swaybg >/dev/null && ! grep -qiE 'Failed|Unable' /tmp/swaybg.log && exit 0
pkill -x swaybg 2>/dev/null
DISPLAY=:0 feh --no-fehbg --bg-fill "$BG" &
exit 0
