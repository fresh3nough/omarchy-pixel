# Omarchy Pixel — tokyo-night + quattro, landscape/monitor-mirror ready
set $mod Mod4
set $term foot
set $bg /home/cody/.local/share/omarchy-pixel/backgrounds/1-quattro.jpg

# Solid fallback; real wallpaper via omarchy-wallpaper (swaybg + bwrap stub)
output * bg #1a1b26 solid_color

default_border pixel 2
default_floating_border pixel 2
font pango:DejaVu Sans Mono 12
gaps inner 6
gaps outer 4
smart_gaps on
smart_borders on
focus_follows_mouse yes

client.focused          #7aa2f7 #1a1b26 #c0caf5 #7aa2f7 #7aa2f7
client.focused_inactive #414868 #1a1b26 #a9b1d6 #414868 #414868
client.unfocused        #1a1b26 #13141c #565f89 #1a1b26 #1a1b26
client.urgent           #f7768e #1a1b26 #c0caf5 #f7768e #f7768e

for_window [app_id="foot"] border pixel 2

bindsym $mod+Return exec $term
bindsym $mod+t exec $term
bindsym $mod+q kill
bindsym $mod+g exec goose
bindsym $mod+b exec env DISPLAY=:0 chromium --ozone-platform=x11 --disable-gpu || chromium
bindsym $mod+f fullscreen
bindsym $mod+Space floating toggle
bindsym $mod+j exec window-arrange
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+Shift+e exit
bindsym $mod+r reload
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

input type:touch {
    tap enabled
    natural_scroll enabled
}
input type:pointer {
    natural_scroll disabled
    accel_profile flat
}

bar {
    swaybar_command waybar
}

exec_always sleep 0.5 && /home/cody/.local/bin/omarchy-wallpaper
exec waybar
exec foot
