{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 4,
  "modules-left": [
    "custom/menu",
    "custom/term",
    "custom/goose-desktop",
    "custom/goose-cli",
    "custom/code",
    "custom/files",
    "custom/browser",
    "custom/onepass",
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory"],
  "custom/menu": {
    "format": "☰",
    "tooltip": "Omarchy command menu",
    "on-click": "omarchy-command menu"
  },
  "custom/term": {
    "format": "TERM",
    "tooltip": "New Pixel foot",
    "on-click": "omarchy-command terminal"
  },
  "custom/goose-desktop": {
    "format": "GOOSE",
    "tooltip": "Open Goose Desktop",
    "on-click": "omarchy-command goose-desktop"
  },
  "custom/goose-cli": {
    "format": "GCLI",
    "tooltip": "Open Goose CLI",
    "on-click": "omarchy-command goose-cli"
  },
  "custom/code": {
    "format": "CODE",
    "tooltip": "Open Visual Studio Code",
    "on-click": "omarchy-command code"
  },
  "custom/files": {
    "format": "FILES",
    "tooltip": "Open file manager",
    "on-click": "omarchy-command files"
  },
  "custom/browser": {
    "format": "WEB",
    "tooltip": "Open Chromium",
    "on-click": "omarchy-command browser"
  },
  "custom/onepass": {
    "format": "1P",
    "tooltip": "Open 1Password",
    "on-click": "omarchy-command onepass"
  },
  "sway/workspaces": { "all-outputs": true, "format": "{name}" },
  "sway/window": { "max-length": 28 },
  "clock": { "interval": 1, "format": "{:%a %b %d   %H:%M:%S}" },
  "cpu": { "interval": 5, "format": "cpu {usage}%" },
  "memory": { "interval": 10, "format": "mem {percentage}%" }
}
