set $mod Mod4
set $term foot
set $bg /home/cody/.local/share/omarchy-pixel/backgrounds/1-quattro.jpg
set $bgpng /home/cody/.local/share/omarchy-pixel/background.png

output * bg #1a1b26 solid_color

default_border pixel 2
default_floating_border pixel 2
font pango:DejaVu Sans Mono 12
gaps inner 8
gaps outer 6

client.focused          #7aa2f7 #1a1b26 #c0caf5 #7aa2f7 #7aa2f7
client.focused_inactive #414868 #1a1b26 #a9b1d6 #414868 #414868
client.unfocused        #1a1b26 #13141c #565f89 #1a1b26 #1a1b26
client.urgent           #f7768e #1a1b26 #c0caf5 #f7768e #f7768e

for_window [app_id="foot"] floating enable
for_window [app_id="foot"] border pixel 2
for_window [app_id="foot"] resize set width 72 ppt height 58 ppt
for_window [app_id="foot"] move position center

bindsym $mod+Return exec $term
bindsym $mod+t exec $term
bindsym $mod+q kill
bindsym $mod+g exec goose
bindsym $mod+b exec chromium --ozone-platform=x11 --disable-gpu || chromium
bindsym $mod+f fullscreen
bindsym $mod+Space floating toggle
bindsym $mod+j exec window-arrange
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+e exit

input type:touch {
    tap enabled
    natural_scroll enabled
}

bar {
    swaybar_command waybar
}

exec_always killall feh 2>/dev/null || true
exec_always feh --bg-fill $bg || feh --bg-fill $bgpng
exec waybar
exec foot
